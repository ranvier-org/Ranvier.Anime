#load "../differential/Harness.fsx"

open System
open System.IO
open System.Text
open Harness

let private fmtZ (v: int) =
    if v < 0 then $"({v})%%Z" else $"{v}%%Z"

let private fmtNat (v: int) = $"{v}"

let private fmtBool (b: bool) = if b then "true" else "false"

let private fmtList (fmt: 'a -> string) (xs: 'a list) =
    "[" + (xs |> List.map fmt |> String.concat "; ") + "]"

let private fmtOpt (noneType: string) (fmt: 'a -> string) (o: 'a option) =
    match o with
    | None -> $"(@None {noneType})"
    | Some x -> $"Some ({fmt x})"

let private fmtTiming ((td, bd, dir, anc, ids): int * int * bool * int * int list) =
    $"({fmtZ td}, {fmtZ bd}, {fmtBool dir}, {fmtZ anc}, {fmtList fmtNat ids})"

let private fmtStagger ((offs, coords): int list * (int * int * int) list) =
    let fCoord (x, y, z) = $"({fmtZ x}, {fmtZ y}, {fmtZ z})"
    $"({fmtList fmtZ offs}, {fmtList fCoord coords})"

let private fmtRoundColor ((rnd, (xs, ys), hm, deg): int list * (int list * int list) * int * int) =
    $"({fmtList fmtZ rnd}, ({fmtList fmtZ xs}, {fmtList fmtZ ys}), {fmtZ hm}, {fmtZ deg})"

let private fmtComp ((bl, st, rem): int * int option * int) =
    let stStr = fmtOpt "Z" fmtZ st
    $"({fmtZ bl}, {stStr}, {fmtZ rem})"

let private fmtDragScroll ((r, inv, edge, (ec, iv)): int * int * int * (int * bool)) =
    $"({fmtZ r}, {fmtZ inv}, {fmtZ edge}, ({fmtNat ec}, {fmtBool iv}))"

let private fmtTransMotion ((cnt, rest, (cl, act)): int * int option * (bool * int option)) =
    let restStr = fmtOpt "Z" fmtZ rest
    let actStr = fmtOpt "nat" fmtNat act
    $"({fmtNat cnt}, {restStr}, ({fmtBool cl}, {actStr}))"

let outPath =
    if fsi.CommandLineArgs.Length > 1 then
        fsi.CommandLineArgs[1]
    else
        Path.Combine(__SOURCE_DIRECTORY__, "../theories/Conformance/Expected.v")

let sb = StringBuilder()
let line (s: string) = sb.Append(s).Append('\n') |> ignore

line "From Stdlib Require Import List ZArith."
line "Import ListNotations."
line "Open Scope nat_scope."
line ""
line "(** Generated by [proofs/conformance/Scenarios.fsx] from real F# runs of"
line "    [Ranvier.Anime] and [Ranvier.View.Anime]. Do not edit by hand. *)"
line ""

let s01 = runTimingEngine 100 3 20 10 true false 190 1 100 137 16 [ 10, 1; -5, 2; 10, 3; 0, 4 ]
line $"Definition exp_S01 := {fmtTiming s01}."
line ""

let s02 = runTimingEngine 50 4 0 0 true true 175 2 0 50 20 [ 5, 10; 5, 11; 1, 12 ]
line $"Definition exp_S02 := {fmtTiming s02}."
line ""

let s03 = runStaggerGrid 3 2 4 (-10) 50 9
line $"Definition exp_S03 := {fmtStagger s03}."
line ""

let s04 = runStaggerGrid 4 3 0 5 (-20) 17
line $"Definition exp_S04 := {fmtStagger s04}."
line ""

let s05 = runRoundAndColor [ -3; -1; 0; 1; 3; 5 ] [ 10; 20 ] [ 1; 2; 3; 4 ] false 350 10 200
line $"Definition exp_S05 := {fmtRoundColor s05}."
line ""

let s06 = runRoundAndColor [ -5; -2; 2; 7 ] [ 5; 6; 7 ] [ 9 ] true 140 275 400
line $"Definition exp_S06 := {fmtRoundColor s06}."
line ""

let s07 = runCompositionTimeline 10 [ true, 500; false, 80; false, 150 ] 10000 20 0 100 200 [ 100; 500 ] 1
line $"Definition exp_S07 := {fmtComp s07}."
line ""

let s08 = runCompositionTimeline 25 [ false, 60; true, 999 ] 5000 10 30 100 (-10) [ 250; 80; 120 ] 0
line $"Definition exp_S08 := {fmtComp s08}."
line ""

let s09 = runDragScroll 0 100 2 (-30) 0 200 400 [ 200; 250; 450; 300 ]
line $"Definition exp_S09 := {fmtDragScroll s09}."
line ""

let s10 = runTransformAndMotion true None [ 20; 80; 40 ] [ Some 1; Some 2; None; Some 3 ]
line $"Definition exp_S10 := {fmtTransMotion s10}."

Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath outPath)) |> ignore
File.WriteAllText(outPath, sb.ToString(), UTF8Encoding(false))
