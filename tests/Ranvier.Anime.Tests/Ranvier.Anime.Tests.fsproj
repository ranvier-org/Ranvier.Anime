<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <Compile Include="RunnerTests.fs" />
    <Compile Include="ReactiveTests.fs" />
    <Compile Include="CssTests.fs" />
    <Compile Include="EaseTests.fs" />
    <Compile Include="SpringTests.fs" />
    <Compile Include="StaggerTests.fs" />
    <Compile Include="TimelineTests.fs" />
    <Compile Include="PlaybackTimingTests.fs" />
    <Compile Include="PlaybackStateTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Ranvier.Anime/Ranvier.Anime.fsproj" />
    <PackageReference Include="Expecto" Version="10.2.3" />
    <PackageReference Include="Ranvier.Css.Bindings$(RanvierPackageSuffix)" Version="[$(RanvierCssBindingsVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../reference/pure.json" Link="reference/pure.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../reference/timer-controls.json" Link="reference/timer-controls.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
