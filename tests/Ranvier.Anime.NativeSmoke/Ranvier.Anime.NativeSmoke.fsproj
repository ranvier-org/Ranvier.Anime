<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RanvierTrace)' == 'true'">
    <DefineConstants>$(DefineConstants);EXPECT_TRACED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <ProjectReference Include="../../src/Ranvier.Anime/Ranvier.Anime.fsproj" />
    <ProjectReference Include="../../upstream/view-aot/src/Ranvier.View.WebCore/Ranvier.View.WebCore.fsproj" />
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="Ranvier.Css.Bindings$(RanvierPackageSuffix)" Version="[$(RanvierCssBindingsVersion)]" />
  </ItemGroup>
  <Target Name="RequirePinnedSourceGraph" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NativeSmokeGraph)' != 'source' and '$(NativeSmokeGraph)' != 'core56'" Text="Run the native smoke through build.fsx to select a qualified source or public-Core graph." />
    <Error Condition="'$(NativeSmokeGraph)' == 'source' and '$(UseLocalRanvier)' != 'true'" Text="The source cohort requires local Core projects." />
    <Error Condition="'$(NativeSmokeGraph)' == 'core56' and ('$(UseLocalRanvier)' == 'true' or '$(RanvierDomVersion)' != '0.1.0-alpha.56')" Text="The public-Core cohort requires actual public DOM alpha.56 packages." />
  </Target>
</Project>
