<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RanvierTrace)' == 'true'">
    <DefineConstants>$(DefineConstants);EXPECT_TRACED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ScopeNativeProbe.fs" />
    <Compile Include="CssScopeNativeProbe.fs" />
    <Compile Include="CssDirectRevertNativeProbe.fs" />
    <Compile Include="ScopeRootNativeProbe.fs" />
    <Compile Include="ScopeDefaultsNativeProbe.fs" />
    <Compile Include="ScopeAnimationDefaultsNativeProbe.fs" />
    <Compile Include="CompositionNativeIdentityProbe.fs" />
    <Compile Include="EngineCoreNativeProbe.fs" />
    <Compile Include="SvgNativeProbe.fs" />
    <Compile Include="ScrollNativeProbe.fs" />
    <Compile Include="Program.fs" />
    <ProjectReference Include="../../src/Ranvier.Anime/Ranvier.Anime.fsproj" />
    <ProjectReference Include="../../upstream/view-aot/src/Ranvier.View.WebCore/Ranvier.View.WebCore.fsproj" Condition="'$(NativeSmokeGraph)' != 'public45'" />
    <PackageReference Include="Ranvier.View.WebCore$(RanvierPackageSuffix)" Version="[0.1.0-alpha.45]" Condition="'$(NativeSmokeGraph)' == 'public45'" />
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
    <PackageReference Include="Ranvier.Css.Bindings$(RanvierPackageSuffix)" Version="[$(RanvierCssBindingsVersion)]" />
  </ItemGroup>
  <Target Name="RequirePinnedSourceGraph" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NativeSmokeGraph)' != 'source' and '$(NativeSmokeGraph)' != 'core56' and '$(NativeSmokeGraph)' != 'public45'" Text="Run the native smoke through build.fsx to select an explicit cohort graph." />
    <Error Condition="'$(NativeSmokeGraph)' == 'source' and '$(UseLocalRanvier)' != 'true'" Text="The source cohort requires local Core projects." />
    <Error Condition="'$(NativeSmokeGraph)' == 'core56' and ('$(UseLocalRanvier)' == 'true' or '$(RanvierDomVersion)' != '0.1.0-alpha.56')" Text="The public-Core cohort requires actual public DOM alpha.56 packages." />
    <Error Condition="'$(NativeSmokeGraph)' == 'public45' and ('$(UseLocalRanvier)' == 'true' or '$(UseLocalRanvierWebCore)' == 'true' or '$(RanvierWebCoreNativeDir)' != '' or '$(RanvierDomVersion)' != '0.1.0-alpha.56')" Text="The public View45 cohort requires package-only Core/View/Native inputs." />
  </Target>
</Project>
