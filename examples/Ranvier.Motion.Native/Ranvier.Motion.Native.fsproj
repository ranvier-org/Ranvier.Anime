<Project Sdk="Microsoft.NET.Sdk">

    <!--
    The Motion example pages of Ranvier.View (examples/Ranvier.Motion) as one native app: an SDL3 window over a WebCore
    page, the Motion parts running on Ranvier.Anime. `dotnet run` opens it; `dotnet run smoke` drives every page in a
    hidden window and exits non-zero on a failed check.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <IsAotCompatible>true</IsAotCompatible>
        <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="src/Native.fs" />
        <Compile Include="src/Kanban.fs" />
        <Compile Include="src/Dashboard.fs" />
        <Compile Include="src/Story.fs" />
        <Compile Include="src/Physics.fs" />
        <Compile Include="src/Routes.fs" />
        <Compile Include="src/Graphs.fs" />
        <Compile Include="src/Shell.fs" />
        <Compile Include="src/Host.fs" />
        <Compile Include="src/Smoke.fs" />
        <Compile Include="src/Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <None Include="styles/*.css" CopyToOutputDirectory="PreserveNewest" LinkBase="styles" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Ranvier.View.Anime/Ranvier.View.Anime.fsproj" />
        <PackageReference Include="Ranvier.View.WebCore.Sdl$(RanvierPackageSuffix)" Version="[$(RanvierViewWebCoreVersion)]" />
        <PackageReference Include="Ranvier.Elmish$(RanvierPackageSuffix)" Version="[0.1.1-preview.1]" />
        <PackageReference Update="FSharp.Core" Version="10.1.401" />
    </ItemGroup>

    <!--
    Windows x64 presents shared D3D11 frames through the GPU runtime in place of the aggregate's Slim one; Program.fs
    asks SDL for its direct3d11 renderer. Other platforms keep the aggregate's Slim runtimes.

    Ranvier.View.WebCore 0.1.0-rc.2 pins the native aggregate to 0.1.1-rc.3. The app takes rc.4 directly for its partial
    root-layer repaint (Ranvier.WebCore#348), which halves a frame on shadowed pages; drop the direct aggregate reference
    and NU1608 once a View.WebCore release depends on rc.4.
    -->
    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
        <NoWarn>$(NoWarn);NU1608</NoWarn>
    </PropertyGroup>
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">
        <PackageReference Include="Ranvier.WebCore.Native" Version="[$(RanvierWebCoreNativeVersion)]" />
        <PackageReference Include="Ranvier.WebCore.Native.win-x64" Version="[$(RanvierWebCoreNativeVersion)]" ExcludeAssets="all" />
        <PackageReference Include="Ranvier.WebCore.Native.Gpu.win-x64" Version="[$(RanvierWebCoreNativeVersion)]" />
    </ItemGroup>
</Project>
