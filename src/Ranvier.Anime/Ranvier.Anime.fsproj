<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Ranvier.Anime</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Ease.fs" />
    <Compile Include="Spring.fs" />
    <Compile Include="Stagger.fs" />
    <Compile Include="CssStagger.fs" />
    <Compile Include="NumericProperty.fs" />
    <Compile Include="PropertyTrack.fs" />
    <Compile Include="ValueInterpolation.fs" />
    <Compile Include="KeyframeCompilation.fs" />
    <Compile Include="FrameSiblings.fs" />
    <Compile Include="Keyframe.fs" />
    <Compile Include="KeyframeSequences.fs" />
    <Compile Include="AnimatableValue.fs" />
    <Compile Include="PlaybackTiming.fs" />
    <Compile Include="PlaybackState.fs" />
    <Compile Include="ScopeRegistration.fs" />
    <Compile Include="Timer.fs" />
    <Compile Include="Scope.fs" />
    <Compile Include="ScopeTimer.fs" />
    <Compile Include="KeyframePlayback.fs" />
    <Compile Include="KeyframeAnimation.fs" />
    <Compile Include="AnimatableTrack.fs" />
    <Compile Include="NumericAnimation.fs" />
    <Compile Include="AnimatableFrames.fs" />
    <Compile Include="AnimatableGroup.fs" />
    <Compile Include="Animatable.fs" />
    <Compile Include="TimelinePosition.fs" />
    <Compile Include="TimelineConstruction.fs" />
    <Compile Include="Timeline.fs" />
    <Compile Include="ScopeAnimation.fs" />
    <Compile Include="Reactive.fs" />
    <Compile Include="CssUnits.fs" />
    <Compile Include="CssPropertyMetadata.fs" />
    <Compile Include="CssSerialization.fs" />
    <Compile Include="CssPropertySnapshot.fs" />
    <Compile Include="Keyframes.fs" />
    <Compile Include="TimelineKeyframes.fs" />
    <Compile Include="TimelineKeyframeSequences.fs" />
    <Compile Include="TimelineCssKeyframes.fs" />
    <Compile Include="TimelineCssKeyframeSequences.fs" />
    <Compile Include="KeyframeSequenceBinding.fs" />
    <Compile Include="AnimatableCss.fs" />
    <Compile Include="Css.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ranvier$(RanvierPackageSuffix)" Version="[0.1.1-preview.1]" Condition="'$(UseLocalRanvier)' != 'true'" />
    <PackageReference Include="Ranvier.Dom$(RanvierPackageSuffix)" Version="[$(RanvierDomVersion)]" Condition="'$(UseLocalRanvier)' != 'true'" />
    <PackageReference Include="Ranvier.Css$(RanvierPackageSuffix)" Version="[$(RanvierCssVersion)]" />
    <PackageReference Include="Ranvier.Css.Dom$(RanvierPackageSuffix)" Version="[0.1.0-alpha.1]" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalRanvier)' == 'true'">
    <ProjectReference Include="$(RanvierRoot)/src/Ranvier/Ranvier.fsproj" />
    <ProjectReference Include="$(RanvierRoot)/src/Ranvier.Dom/Ranvier.Dom.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ranvier.Anime.Tests" />
    <InternalsVisibleTo Include="Ranvier.Anime.NativeSmoke" />
  </ItemGroup>
</Project>
